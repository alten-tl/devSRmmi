NODE_ENV=local
IS_LOCAL=true
LOG_LEVEL=debug
LOG_PRETTY=false
AWS_REGION=us-east-1

# Local database (Docker). Inside the SAM network the host is the service name.
DB_HOST=appointments-db
DB_PORT=5432
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=appointments_db
DB_MAX_POOL=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_SSL=false
DB_APP_NAME=sam-appointments-crud

# Port published on the host by docker-compose (change if 5432 is in use).
HOST_DB_PORT=5434

# Optional in production: Secrets Manager ARN holding {username, password}.
# DB_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:appointments/db